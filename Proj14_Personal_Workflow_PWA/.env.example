# Copy to .env and fill in. .env is git-ignored and must never be committed.
# Use the dedicated schedule_app user, NOT the CouchDB server admin account.
# schedule_app must be a DB ADMIN (via the schedule db's _security.admins) so
# it can write the _design/app doc that deploy.py ships, but it must NOT be a
# server admin: it should have no rights on any other database on this host.
COUCHDB_URL=http://127.0.0.1:5700
COUCHDB_USER=schedule_app
COUCHDB_PASSWORD=
COUCHDB_DB=schedule

# Google Calendar. Create a Desktop-app OAuth client in the Google Cloud console,
# then run: py scripts/google_auth.py
# GOOGLE_REFRESH_TOKEN is printed by that script. All three are secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Name of the dedicated calendar. Never the primary calendar.
GOOGLE_CALENDAR_NAME=Schedule
# IANA timezone for every event written.
SCHEDULE_TIMEZONE=Asia/Manila

# Obsidian Local REST API. The key comes from the plugin's settings pane.
# OBSIDIAN_NOTE_PATH is vault-relative. OBSIDIAN_API_URL rarely changes.
OBSIDIAN_API_KEY=
OBSIDIAN_NOTE_PATH=Schedule.md
OBSIDIAN_API_URL=http://127.0.0.1:27123

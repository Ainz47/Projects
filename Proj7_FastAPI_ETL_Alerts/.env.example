# Shared secret both webhook senders put in the X-Webhook-Secret header. Required: without it every webhook gets 503.
WEBHOOK_SECRET="a-long-random-string"
# Discord (or Slack-compatible) incoming webhook. Optional: without it metrics are stored but no alert is sent.
ALERT_WEBHOOK_URL="https://discord.com/api/webhooks/your-long-url-here"
# Supabase project URL and SERVICE-ROLE key (server side only). Optional: without them an in-memory store is used.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-service-role-key"
# Alert when labor cost is above this % of sales. Default 25.
LABOR_ALERT_PCT="25"

{
    "name": "order-stock-sync",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": 2838878
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                }
            }
        },
        {
            "id": 10,
            "module": "datastore:GetRecord",
            "version": 1,
            "parameters": {
                "datastore": 154577
            },
            "mapper": {
                "key": "shopify_webhook_secret",
                "returnWrapped": false
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                }
            }
        },
        {
            "id": 11,
            "module": "json:ParseJSON",
            "version": 1,
            "parameters": {},
            "filter": {
                "name": "Shopify HMAC valid",
                "conditions": [
                    [
                        {
                            "a": "{{sha256(1.value; \"base64\"; 10.value)}}",
                            "b": "{{get(map(1.__IMTHEADERS__; \"value\"; \"name\"; \"x-shopify-hmac-sha256\"); 1)}}",
                            "o": "text:equal"
                        }
                    ]
                ]
            },
            "mapper": {
                "json": "{{1.value}}"
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                }
            }
        },
        {
            "id": 2,
            "module": "builtin:BasicFeeder",
            "version": 1,
            "parameters": {},
            "mapper": {
                "array": "{{11.line_items}}"
            },
            "metadata": {
                "designer": {
                    "x": 900,
                    "y": 0
                }
            }
        },
        {
            "id": 3,
            "module": "shopify:makeAnApiCall",
            "version": 3,
            "parameters": {
                "__IMTCONN__": 11222622
            },
            "mapper": {
                "query": "query Stock($search: String!) {\n  productVariants(first: 250, query: $search) {\n    nodes { sku inventoryQuantity inventoryItem { tracked } }\n  }\n}",
                "variables": "{\"search\": \"sku:\\\"{{2.sku}}\\\"\"}",
                "handleErrors": true,
                "flattenResponse": false,
                "variablesDataSource": "object"
            },
            "metadata": {
                "designer": {
                    "x": 1200,
                    "y": 0
                }
            }
        },
        {
            "id": 4,
            "module": "airtable:ActionSearchRecords",
            "version": 3,
            "parameters": {
                "__IMTCONN__": 11222232
            },
            "mapper": {
                "base": "applddLjh3EVYvA3x",
                "table": "tblSpS0xcK3qlA40v",
                "formula": "{SKU} = '{{2.sku}}'",
                "maxRecords": 1
            },
            "metadata": {
                "designer": {
                    "x": 1500,
                    "y": 0
                }
            }
        },
        {
            "id": 5,
            "module": "airtable:ActionUpdateRecords",
            "version": 3,
            "parameters": {
                "__IMTCONN__": 11222232
            },
            "filter": {
                "name": "One exact SKU, stock differs",
                "conditions": [
                    [
                        {
                            "a": "{{length(map(3.body.data.productVariants.nodes; \"sku\"; \"sku\"; 2.sku))}}",
                            "b": "1",
                            "o": "number:equal"
                        },
                        {
                            "a": "{{get(map(3.body.data.productVariants.nodes; \"inventoryQuantity\"; \"sku\"; 2.sku); 1)}}",
                            "b": "{{4.Stock}}",
                            "o": "number:notequal"
                        }
                    ]
                ]
            },
            "mapper": {
                "id": "{{4.id}}",
                "base": "applddLjh3EVYvA3x",
                "table": "tblSpS0xcK3qlA40v",
                "record": {
                    "fldOKzR4V97mX3pj2": "{{get(map(3.body.data.productVariants.nodes; \"inventoryQuantity\"; \"sku\"; 2.sku); 1)}}"
                },
                "typecast": false
            },
            "metadata": {
                "designer": {
                    "x": 1800,
                    "y": 0
                }
            }
        },
        {
            "id": 6,
            "module": "google-sheets:addRow",
            "version": 2,
            "parameters": {
                "__IMTCONN__": 11222239
            },
            "mapper": {
                "mode": "map",
                "values": {
                    "0": "{{now}}",
                    "1": "{{2.sku}}",
                    "2": "{{4.Stock}}",
                    "3": "{{get(map(3.body.data.productVariants.nodes; \"inventoryQuantity\"; \"sku\"; 2.sku); 1)}}",
                    "4": "make",
                    "5": "{{11.name}}"
                },
                "sheetId": "StockLog",
                "spreadsheetId": "1VbnpMSjRZCsIEL3rsB8K4QAR2eHZN79faR1DeCVoeMk",
                "tableFirstRow": "A1:Z1",
                "valueInputOption": "USER_ENTERED",
                "insertUnformatted": false
            },
            "metadata": {
                "designer": {
                    "x": 2100,
                    "y": 0
                }
            }
        },
        {
            "id": 12,
            "module": "builtin:BasicAggregator",
            "version": 1,
            "parameters": {
                "feeder": 2
            },
            "mapper": {
                "sku": "{{2.sku}}"
            },
            "metadata": {
                "designer": {
                    "x": 2400,
                    "y": 0
                }
            }
        },
        {
            "id": 7,
            "module": "datastore:GetRecord",
            "version": 1,
            "parameters": {
                "datastore": 154577
            },
            "filter": {
                "name": "Any SKU changed",
                "conditions": [
                    [
                        {
                            "a": "{{length(12.array)}}",
                            "b": "0",
                            "o": "number:greater"
                        }
                    ]
                ]
            },
            "mapper": {
                "key": "github_dispatch_token",
                "returnWrapped": false
            },
            "metadata": {
                "designer": {
                    "x": 2700,
                    "y": 0
                }
            }
        },
        {
            "id": 8,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "https://api.github.com/repos/Ainz47/Projects/dispatches",
                "data": "{\"event_type\":\"catalog-refresh\"}",
                "gzip": true,
                "method": "post",
                "headers": [
                    {
                        "name": "Authorization",
                        "value": "Bearer {{7.value}}"
                    },
                    {
                        "name": "Accept",
                        "value": "application/vnd.github+json"
                    }
                ],
                "useMtls": false,
                "bodyType": "raw",
                "contentType": "application/json",
                "serializeUrl": false,
                "shareCookies": false,
                "parseResponse": false,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 3000,
                    "y": 0
                }
            },
            "onerror": [
                {
                    "id": 9,
                    "module": "builtin:Break",
                    "version": 1,
                    "parameters": {},
                    "mapper": {
                        "count": 3,
                        "retry": true,
                        "interval": 15
                    },
                    "metadata": {
                        "designer": {
                            "x": 3300,
                            "y": 0
                        }
                    }
                }
            ]
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": true,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "us2.make.com",
        "notes": []
    }
}
# ============================================================
# rank_rent_automation - Environment Configuration
# Copy this file to .env and fill in your own credentials.
# ============================================================

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.1-flash-lite-preview,gemini-3-flash-preview
GEMINI_RETRY_SECONDS=8

# WordPress REST API Handshake
WP_URL=https://shruggovernment.s6-tastewp.com/wp-json/wp/v2
WP_USERNAME=admin
WP_APP_PASSWORD=your_wordpress_application_password_here

# SEO & Hierarchy
PARENT_PAGE_NAME=Michigan
PARENT_PAGE_ID=0
TARGET_STATE=MI

# Pipeline Settings
INPUT_FILE=source_fleet.csv
USE_CACHED_GEMINI=false
GEMINI_CALL_DELAY_SECONDS=5
